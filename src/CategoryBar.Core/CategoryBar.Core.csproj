<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Languages/*.json" LogicalName="CategoryBar.Core.Languages.%(Filename).json" /></ItemGroup>
  <!-- Built-in themes are plain theme folders; "ThemeStyles/studio.css" holds the defaults every theme inherits. -->
  <ItemGroup><EmbeddedResource Include="ThemeStyles/**/*" LogicalName="ThemeStyles/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
</Project>
