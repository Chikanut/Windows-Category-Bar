<Window x:Class="CategoryBar.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Панель категорій — Налаштування" Width="820" Height="640" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Settings.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid x:Name="Shell" Background="#202024" TextElement.FontFamily="Segoe UI" TextElement.FontSize="12" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag"><Grid>
      <TextBlock Text="Панель категорій — Налаштування" Foreground="#BDBDC4" FontSize="12.5" VerticalAlignment="Center" Margin="16,0,96,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="—" Width="46" Height="39" HorizontalContentAlignment="Center" Padding="0" Foreground="#8E8E98" Click="Minimize" ToolTip="Згорнути"/>
        <Button Content="✕" Width="46" Height="39" HorizontalContentAlignment="Center" Padding="0" Foreground="#8E8E98" Click="CloseSettings" ToolTip="Закрити"/>
      </StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="8,12">
        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Загальне" Tag="General" Checked="Navigate"/>
        <RadioButton x:Name="PanelNavigation" Style="{StaticResource Navigation}" GroupName="Navigation" Content="Панель і меню" Tag="Panel" Checked="Navigate"/>
        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Категорії" Tag="Categories" Checked="Navigate"/>
        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Про програму" Tag="About" Checked="Navigate"/>
      </StackPanel>
      <Grid Grid.Column="1" Background="#1B1B1E"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="28,20,28,18">
            <StackPanel x:Name="PanelPage">
              <TextBlock Text="Панель і меню" FontSize="22" FontWeight="SemiBold" Foreground="#F2F2F4" Margin="0,0,0,18"/>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Монітори" Style="{StaticResource SettingsText}"/><TextBlock Text="Де показувати панель категорій" Style="{StaticResource SettingsHint}"/></StackPanel>
                <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="6" Padding="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segment}" x:Name="PrimaryMonitor" GroupName="Monitors" Content="Лише основний" Checked="BehaviorChanged"/>
                  <RadioButton Style="{StaticResource Segment}" x:Name="AllMonitors" GroupName="Monitors" Content="Усі з панеллю Windows" Checked="BehaviorChanged"/>
                </StackPanel></Border>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Розгорнуті вікна" Style="{StaticResource SettingsText}"/><TextBlock Text="Резерв зменшує вікна на висоту панелі" Style="{StaticResource SettingsHint}"/></StackPanel>
                <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="6" Padding="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Segment}" x:Name="OverlayMode" GroupName="Reservation" Content="Перекривати" Checked="BehaviorChanged"/>
                  <RadioButton Style="{StaticResource Segment}" x:Name="ReserveMode" GroupName="Reservation" Content="Резервувати місце" Checked="BehaviorChanged"/>
                </StackPanel></Border>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Вирівнювання" Style="{StaticResource SettingsText}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="6" Padding="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="WindowsAlignment" Style="{StaticResource Segment}" GroupName="Alignment" Content="Як у Windows" Tag="Windows" Checked="AlignmentChanged"/>
                  <RadioButton x:Name="LeftAlignment" Style="{StaticResource Segment}" GroupName="Alignment" Content="Ліворуч" Tag="Left" Checked="AlignmentChanged"/>
                  <RadioButton x:Name="CenterAlignment" Style="{StaticResource Segment}" GroupName="Alignment" Content="По центру" Tag="Center" Checked="AlignmentChanged"/>
                </StackPanel></Border>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Затримка відкриття" Style="{StaticResource SettingsText}"/><TextBlock Text="Захист від випадкових наведень" Style="{StaticResource SettingsHint}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Slider x:Name="Opening" Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="600" TickFrequency="25" ValueChanged="DelayChanged" ToolTip="Затримка відкриття меню"/>
                  <TextBlock x:Name="OpeningLabel" FontFamily="Consolas" FontSize="12" Width="52" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Затримка закриття" Style="{StaticResource SettingsText}"/><TextBlock Text="Час на перехід курсора до меню" Style="{StaticResource SettingsHint}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Slider x:Name="ClosingDelay" Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="1000" TickFrequency="50" ValueChanged="DelayChanged" ToolTip="Затримка закриття меню"/>
                  <TextBlock x:Name="ClosingLabel" FontFamily="Consolas" FontSize="12" Width="52" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Показувати кількість ярликів" Style="{StaticResource SettingsText}"/><TextBlock Text="Число біля назви категорії" Style="{StaticResource SettingsHint}"/></StackPanel>
                <CheckBox x:Name="Counts" Grid.Column="1" Style="{StaticResource Switch}" Checked="CountsChanged" Unchecked="CountsChanged" ToolTip="Показувати кількість ярликів"/>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Пошук у меню" Style="{StaticResource SettingsText}"/><TextBlock Text="Поле пошуку в довгих категоріях" Style="{StaticResource SettingsHint}"/></StackPanel>
                <Border Grid.Column="1" Background="#0FFFFFFF" CornerRadius="6" Padding="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ThresholdSearch" Style="{StaticResource Segment}" GroupName="Search" Content="Від 15" Tag="15" Checked="SearchChanged"/>
                  <RadioButton x:Name="AlwaysSearch" Style="{StaticResource Segment}" GroupName="Search" Content="Завжди" Tag="0" Checked="SearchChanged"/>
                  <RadioButton x:Name="NeverSearch" Style="{StaticResource Segment}" GroupName="Search" Content="Ніколи" Tag="2147483647" Checked="SearchChanged"/>
                </StackPanel></Border>
              </Grid></Border>
            </StackPanel>
            <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
              <TextBlock Text="Загальне" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Запускати з Windows" Style="{StaticResource SettingsText}"/><TextBlock Text="Показувати панель після входу в систему" Style="{StaticResource SettingsHint}"/></StackPanel>
                <CheckBox x:Name="Startup" Grid.Column="1" Style="{StaticResource Switch}" Checked="StartupChanged" Unchecked="StartupChanged" ToolTip="Запускати з Windows"/>
              </Grid></Border>
              <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="Локальні дані" Style="{StaticResource SettingsText}"/><TextBlock x:Name="ConfigLocation" Style="{StaticResource SettingsHint}" Margin="0,6,0,14"/>
                <Button Content="Відкрити папку налаштувань" Click="OpenConfigFolder" Background="#18FFFFFF" HorizontalAlignment="Left" Height="32"/>
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="CategoriesPage" Visibility="Collapsed">
              <TextBlock Text="Категорії" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <CheckBox x:Name="GridMode" Content="Сітка для категорій із 20 або більше ярликами" Foreground="#ECECEF" Margin="0,0,0,16" Checked="GridChanged" Unchecked="GridChanged"/><StackPanel x:Name="CategoryRows"/>
              <Button Content="＋ Створити категорію" Click="CreateCategory" Background="#18FFFFFF" HorizontalAlignment="Left" Height="32"/>
            </StackPanel>
            <StackPanel x:Name="AboutPage" Visibility="Collapsed">
              <TextBlock Text="Про програму" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <Border Style="{StaticResource SettingsCard}"><StackPanel>
                <TextBlock Text="Панель категорій" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Версія 0.1 · Windows 11" Style="{StaticResource SettingsHint}" Margin="0,6,0,16"/>
                <TextBlock Text="Ваші програми — у категоріях над панеллю Windows. Наведіть курсор на категорію, щоб відкрити меню, і натисніть програму для запуску." Style="{StaticResource SettingsHint}"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <TextBlock x:Name="SaveError" Grid.Row="1" Foreground="#FF9A92" TextWrapping="Wrap" Margin="28,0,28,16" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
