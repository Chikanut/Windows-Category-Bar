<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fx="clr-namespace:CategoryBar.Theming">
<!--
  The shared renderer. Every key here can be replaced by a theme's own styles.xaml, and every number and paint
  comes from the theme's stylesheet as a "<selector>.<Property>" resource.
  Materials paint only the background: text and hit targets never pass through a material's shader.
  Theme.MaterialTemplate draws large surfaces, Theme.ControlMaterialTemplate draws tabs, rows, buttons and inputs.
-->
<ControlTemplate x:Key="Theme.MaterialTemplate" TargetType="ContentControl">
  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
</ControlTemplate>
<ControlTemplate x:Key="Theme.ControlMaterialTemplate" TargetType="ContentControl">
  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
</ControlTemplate>
<ControlTemplate x:Key="Theme.BarTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource bar.Radius}" Effect="{DynamicResource bar.Shadow}"/>
  <Border Background="{DynamicResource bar.Overlay}" CornerRadius="{DynamicResource bar.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource bar.Rim}" BorderThickness="{DynamicResource bar.RimWidth}" CornerRadius="{DynamicResource bar.Radius}" Margin="1" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Bar" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.BarTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource bar.Background}"/><Setter Property="Foreground" Value="{DynamicResource bar.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource bar.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource bar.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource bar.Padding}"/><Setter Property="Opacity" Value="{DynamicResource bar.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.MenuTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource menu.Radius}" Effect="{DynamicResource menu.Shadow}"/>
  <Border Background="{DynamicResource menu.Overlay}" CornerRadius="{DynamicResource menu.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource menu.Rim}" BorderThickness="{DynamicResource menu.RimWidth}" CornerRadius="{DynamicResource menu.Radius}" Margin="1" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Menu" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.MenuTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource menu.Background}"/><Setter Property="Foreground" Value="{DynamicResource menu.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource menu.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource menu.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource menu.Padding}"/><Setter Property="Opacity" Value="{DynamicResource menu.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.SidebarTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource sidebar.Radius}" Effect="{DynamicResource sidebar.Shadow}"/>
  <Border Background="{DynamicResource sidebar.Overlay}" CornerRadius="{DynamicResource sidebar.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource sidebar.Rim}" BorderThickness="{DynamicResource sidebar.RimWidth}" CornerRadius="{DynamicResource sidebar.Radius}" Margin="1" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Sidebar" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.SidebarTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource sidebar.Background}"/><Setter Property="Foreground" Value="{DynamicResource sidebar.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource sidebar.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource sidebar.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource sidebar.Padding}"/><Setter Property="Opacity" Value="{DynamicResource sidebar.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.TitleBarTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource titlebar.Radius}" Effect="{DynamicResource titlebar.Shadow}"/>
  <Border Background="{DynamicResource titlebar.Overlay}" CornerRadius="{DynamicResource titlebar.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource titlebar.Rim}" BorderThickness="{DynamicResource titlebar.RimWidth}" CornerRadius="{DynamicResource titlebar.Radius}" Margin="1" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.TitleBar" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.TitleBarTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource titlebar.Background}"/><Setter Property="Foreground" Value="{DynamicResource titlebar.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource titlebar.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource titlebar.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource titlebar.Padding}"/><Setter Property="Opacity" Value="{DynamicResource titlebar.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.PageTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource page.Radius}" Effect="{DynamicResource page.Shadow}"/>
  <Border Background="{DynamicResource page.Overlay}" CornerRadius="{DynamicResource page.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource page.Rim}" BorderThickness="{DynamicResource page.RimWidth}" CornerRadius="{DynamicResource page.Radius}" Margin="1" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Page" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.PageTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource page.Background}"/><Setter Property="Foreground" Value="{DynamicResource page.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource page.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource page.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource page.Padding}"/><Setter Property="Opacity" Value="{DynamicResource page.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.ToastTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource toast.Radius}" Effect="{DynamicResource toast.Shadow}"/>
  <Border Background="{DynamicResource toast.Overlay}" CornerRadius="{DynamicResource toast.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource toast.Rim}" BorderThickness="{DynamicResource toast.RimWidth}" CornerRadius="{DynamicResource toast.Radius}" Margin="1" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Toast" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.ToastTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource toast.Background}"/><Setter Property="Foreground" Value="{DynamicResource toast.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource toast.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource toast.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource toast.Padding}"/><Setter Property="Opacity" Value="{DynamicResource toast.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.TabTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.ControlMaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource tab.Radius}" Effect="{DynamicResource tab.Shadow}"/>
  <Border Background="{DynamicResource tab.Overlay}" CornerRadius="{DynamicResource tab.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource tab.Rim}" BorderThickness="{DynamicResource tab.RimWidth}" CornerRadius="{DynamicResource tab.Radius}" Margin="1" IsHitTestVisible="False"/>
  <Border x:Name="state" Background="Transparent" CornerRadius="{DynamicResource tab.Radius}" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
  <Border x:Name="indicator" Tag="{DynamicResource tab.Indicator}" Height="2" CornerRadius="1" Margin="8,0,8,1" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Opacity="0" IsHitTestVisible="False"/>
</Grid>
<ControlTemplate.Triggers>
  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource tab:hover.Background}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource tab:hover.BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource tab:hover.Foreground}"/><Setter TargetName="face" Property="Effect" Value="{DynamicResource tab:hover.Shadow}"/></Trigger>
  <Trigger Property="fx:ThemeVisual.IsSelected" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource tab:selected.Background}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource tab:selected.BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource tab:selected.Foreground}"/><Setter TargetName="face" Property="Effect" Value="{DynamicResource tab:selected.Shadow}"/></Trigger>
  <Trigger Property="fx:ThemeVisual.IsDropTarget" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource tab:selected.Background}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="face" Property="BorderThickness" Value="2"/></Trigger>
  <Trigger Property="fx:ThemeVisual.IsRunning" Value="True"><Setter TargetName="indicator" Property="Opacity" Value=".7"/><Setter TargetName="indicator" Property="Width" Value="10"/><Setter TargetName="indicator" Property="HorizontalAlignment" Value="Center"/></Trigger>
  <Trigger Property="fx:ThemeVisual.IsSelected" Value="True"><Setter TargetName="indicator" Property="Opacity" Value="1"/><Setter TargetName="indicator" Property="Width" Value="NaN"/><Setter TargetName="indicator" Property="HorizontalAlignment" Value="Stretch"/></Trigger>
  <Trigger SourceName="indicator" Property="Tag" Value="dot"><Setter TargetName="indicator" Property="Width" Value="5"/><Setter TargetName="indicator" Property="Height" Value="3"/><Setter TargetName="indicator" Property="Margin" Value="0,0,0,2"/><Setter TargetName="indicator" Property="HorizontalAlignment" Value="Center"/></Trigger>
  <Trigger SourceName="indicator" Property="Tag" Value="rail"><Setter TargetName="indicator" Property="Width" Value="3"/><Setter TargetName="indicator" Property="Height" Value="14"/><Setter TargetName="indicator" Property="Margin" Value="4,0,0,0"/><Setter TargetName="indicator" Property="HorizontalAlignment" Value="Left"/><Setter TargetName="indicator" Property="VerticalAlignment" Value="Center"/></Trigger>
  <MultiTrigger><MultiTrigger.Conditions><Condition SourceName="indicator" Property="Tag" Value="none"/><Condition Property="fx:ThemeVisual.IsRunning" Value="False"/></MultiTrigger.Conditions><Setter TargetName="indicator" Property="Opacity" Value="0"/></MultiTrigger>
</ControlTemplate.Triggers></ControlTemplate>
<Style x:Key="Theme.Tab" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.TabTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource tab.Background}"/><Setter Property="Foreground" Value="{DynamicResource tab.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource tab.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource tab.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource tab.Padding}"/><Setter Property="Opacity" Value="{DynamicResource tab.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<ControlTemplate x:Key="Theme.MenuItemTemplate" TargetType="ContentControl"><Grid Background="Transparent">
  <ContentControl x:Name="face" Focusable="False" IsHitTestVisible="False" Template="{DynamicResource Theme.ControlMaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource menu-item.Radius}" Effect="{DynamicResource menu-item.Shadow}"/>
  <Border Background="{DynamicResource menu-item.Overlay}" CornerRadius="{DynamicResource menu-item.Radius}" IsHitTestVisible="False"/>
  <Border BorderBrush="{DynamicResource menu-item.Rim}" BorderThickness="{DynamicResource menu-item.RimWidth}" CornerRadius="{DynamicResource menu-item.Radius}" Margin="1" IsHitTestVisible="False"/>
  <Border x:Name="state" Background="Transparent" CornerRadius="{DynamicResource menu-item.Radius}" IsHitTestVisible="False"/>
  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
</Grid>
<ControlTemplate.Triggers>
  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource menu-item:hover.Background}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource menu-item:hover.BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource menu-item:hover.Foreground}"/><Setter TargetName="face" Property="Effect" Value="{DynamicResource menu-item:hover.Shadow}"/></Trigger>
  <Trigger Property="fx:ThemeVisual.IsSelected" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource menu-item:selected.Background}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource menu-item:selected.BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource menu-item:selected.Foreground}"/><Setter TargetName="face" Property="Effect" Value="{DynamicResource menu-item:selected.Shadow}"/></Trigger>
  <Trigger Property="fx:ThemeVisual.IsDropTarget" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource menu-item:selected.Background}"/><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="face" Property="BorderThickness" Value="2"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate>
<Style x:Key="Theme.MenuItem" TargetType="ContentControl">
  <Setter Property="Template" Value="{DynamicResource Theme.MenuItemTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource menu-item.Background}"/><Setter Property="Foreground" Value="{DynamicResource menu-item.Foreground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource menu-item.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource menu-item.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource menu-item.Padding}"/><Setter Property="Opacity" Value="{DynamicResource menu-item.Opacity}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
</Style>
<!-- Menu heading: Header is the category name, Tag the same name in capitals, Content the tools on the right. -->
<ControlTemplate x:Key="Theme.MenuHeaderTemplate" TargetType="fx:ThemeSurface">
  <Grid Margin="10,4,4,6" MinHeight="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
  </Grid>
</ControlTemplate>
<Style x:Key="Theme.MenuHeader" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.MenuHeaderTemplate}"/><Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/></Style>

<!-- Windows: Header and Content are slots; a theme may arrange them in any composition. -->
<ControlTemplate x:Key="Theme.WindowTemplate" TargetType="fx:ThemeSurface">
<Grid Background="Transparent">
  <ContentControl Template="{DynamicResource Theme.MaterialTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource window.Radius}" IsHitTestVisible="False" Focusable="False"/>
  <Border Background="{DynamicResource window.Overlay}" CornerRadius="{DynamicResource window.Radius}" IsHitTestVisible="False"/>
  <Grid Margin="{TemplateBinding Padding}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <ContentControl Style="{DynamicResource Theme.TitleBar}" Height="{DynamicResource titlebar.Height}" Content="{TemplateBinding Header}"/>
    <ContentPresenter Grid.Row="1"/>
  </Grid>
</Grid></ControlTemplate>
<Style x:Key="Theme.Window" TargetType="fx:ThemeSurface">
  <Setter Property="Template" Value="{DynamicResource Theme.WindowTemplate}"/>
  <Setter Property="Background" Value="{DynamicResource window.Background}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource window.BorderBrush}"/><Setter Property="BorderThickness" Value="{DynamicResource window.Border}"/>
  <Setter Property="Padding" Value="{DynamicResource window.Padding}"/>
</Style>
<ControlTemplate x:Key="Theme.CaptionTemplate" TargetType="fx:ThemeSurface">
<Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <ContentPresenter Content="{TemplateBinding Header}" Margin="14,0,12,0" VerticalAlignment="Center"/>
  <ContentPresenter Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Caption" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.CaptionTemplate}"/></Style>
<ControlTemplate x:Key="Theme.WorkspaceTemplate" TargetType="fx:ThemeSurface">
<Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <ContentControl Style="{DynamicResource Theme.Sidebar}" Width="{DynamicResource sidebar.Width}" Margin="{DynamicResource sidebar.Margin}" Content="{TemplateBinding Header}"/>
  <ContentControl Grid.Column="1" Style="{DynamicResource Theme.Page}" Margin="{DynamicResource page.Margin}" Content="{TemplateBinding Content}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Workspace" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.WorkspaceTemplate}"/></Style>
<Style x:Key="Theme.NavigationPanel" TargetType="StackPanel"><Setter Property="Margin" Value="10,6,10,10"/></Style>
<Style x:Key="Theme.BoardColumn" TargetType="ContentControl" BasedOn="{StaticResource Theme.Sidebar}"><Setter Property="Padding" Value="4"/></Style>

<!-- A settings row: Header is the label and hint, Content the control. -->
<ControlTemplate x:Key="Theme.SettingTemplate" TargetType="fx:ThemeSurface">
<ContentControl Style="{DynamicResource Theme.Card}"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
  <ContentPresenter Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"/>
</Grid></ContentControl></ControlTemplate>
<ControlTemplate x:Key="Theme.SettingStackedTemplate" TargetType="fx:ThemeSurface"><ContentControl Style="{DynamicResource Theme.Card}"><StackPanel>
  <ContentPresenter Content="{TemplateBinding Header}"/><ContentPresenter Margin="0,12,0,0" HorizontalAlignment="Left"/>
</StackPanel></ContentControl></ControlTemplate>
<Style x:Key="Theme.Setting" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.SettingTemplate}"/>
<Style.Triggers><Trigger Property="Tag" Value="stacked"><Setter Property="Template" Value="{DynamicResource Theme.SettingStackedTemplate}"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
