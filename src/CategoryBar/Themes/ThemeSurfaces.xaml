<ControlTemplate x:Key="Theme.WorkspaceTemplate" TargetType="fx:ThemeSurface">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
<ContentControl Style="{DynamicResource Theme.Sidebar}" Width="208" Content="{TemplateBinding Header}"/>
<ContentControl Grid.Column="1" Style="{DynamicResource Theme.Page}" Content="{TemplateBinding Content}"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Workspace" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.WorkspaceTemplate}"/></Style>
<ControlTemplate x:Key="Theme.SettingTemplate" TargetType="fx:ThemeSurface">
<ContentControl Style="{DynamicResource Theme.Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
<ContentPresenter Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"/>
</Grid></ContentControl></ControlTemplate>
<ControlTemplate x:Key="Theme.SettingStackedTemplate" TargetType="fx:ThemeSurface"><ContentControl Style="{DynamicResource Theme.Card}"><StackPanel>
<ContentPresenter Content="{TemplateBinding Header}"/><ContentPresenter Margin="0,12,0,0" HorizontalAlignment="Left"/>
</StackPanel></ContentControl></ControlTemplate>
<Style x:Key="Theme.Setting" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.SettingTemplate}"/>
<Style.Triggers><Trigger Property="Tag" Value="stacked"><Setter Property="Template" Value="{DynamicResource Theme.SettingStackedTemplate}"/></Trigger></Style.Triggers></Style>
<Style x:Key="Theme.NavigationPanel" TargetType="StackPanel"><Setter Property="Margin" Value="10,6,10,10"/></Style>
<Style x:Key="Theme.BoardColumn" TargetType="ContentControl" BasedOn="{StaticResource Theme.Sidebar}"><Setter Property="Padding" Value="4"/></Style>
<ControlTemplate x:Key="Theme.CaptionTemplate" TargetType="fx:ThemeSurface">
<Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ContentPresenter Content="{TemplateBinding Header}" Margin="14,0,12,0" VerticalAlignment="Center"/>
<ContentPresenter Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
</Grid></ControlTemplate>
<Style x:Key="Theme.Caption" TargetType="fx:ThemeSurface"><Setter Property="Template" Value="{DynamicResource Theme.CaptionTemplate}"/></Style>
