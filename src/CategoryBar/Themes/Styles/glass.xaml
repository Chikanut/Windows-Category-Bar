<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="Theme.ButtonTemplate" TargetType="Button">
    <Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource button.Radius}"/>
      <Border Background="{DynamicResource Glass.Sheen}" CornerRadius="{DynamicResource button.Radius}" IsHitTestVisible="False"/>
      <Border Margin="2" BorderBrush="{DynamicResource Glass.Rim}" BorderThickness="1,1,1,0" CornerRadius="{DynamicResource button.Radius}" IsHitTestVisible="False"/>
      <Border x:Name="state" Background="{DynamicResource Accent.Soft}" CornerRadius="{DynamicResource button.Radius}" Opacity="0"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="state" Property="Opacity" Value=".6"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="state" Property="Opacity" Value="1"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="Theme.CardTemplate" TargetType="ContentControl">
    <Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource card.Radius}"/>
      <Border Margin="2" BorderBrush="{DynamicResource Glass.Rim}" BorderThickness="1,1,1,0" CornerRadius="{DynamicResource card.Radius}" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="Theme.InputTemplate" TargetType="TextBox">
    <Grid>
      <Border x:Name="shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource input.Radius}"/>
      <Border Background="{DynamicResource Glass.Sheen}" CornerRadius="{DynamicResource input.Radius}" IsHitTestVisible="False"/>
      <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Text.Faint}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="shell" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
