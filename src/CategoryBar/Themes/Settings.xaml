<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <Style x:Key="SettingsText" TargetType="TextBlock"><Setter Property="Foreground" Value="#ECECEF"/><Setter Property="FontSize" Value="13.5"/></Style>
  <Style x:Key="SettingsHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#8E8E98"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
  <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="#26262B"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="MinHeight" Value="60"/></Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#A6A6B0"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="surface" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="surface" Property="Background" Value="#1FFFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="surface" Property="Background" Value="#10FFFFFF"/></MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#8EA8FF"/><Setter TargetName="surface" Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#686872"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Navigation" TargetType="RadioButton">
    <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Foreground" Value="#D0D0D6"/><Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="surface" Background="Transparent" CornerRadius="6"><Grid>
        <Border x:Name="line" Width="3" Margin="0,10" Background="#8EA8FF" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="12,0" VerticalAlignment="Center"/>
      </Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="surface" Property="Background" Value="#12FFFFFF"/><Setter TargetName="line" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="surface" Property="Background" Value="#08FFFFFF"/></MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#8EA8FF"/><Setter TargetName="surface" Property="BorderThickness" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Width" Value="40"/><Setter Property="Height" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="track" CornerRadius="10" Background="#1FFFFFFF"><Grid>
        <Ellipse x:Name="knob" Fill="#A6A6B0" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0"/>
      </Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="#8EA8FF"/><Setter TargetName="knob" Property="Fill" Value="#141826"/><Setter TargetName="knob" Property="Margin" Value="23,0,0,0"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="White"/><Setter TargetName="track" Property="BorderThickness" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SliderRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/><Setter Property="Height" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSlider" TargetType="Slider">
    <Setter Property="Height" Value="24"/><Setter Property="Width" Value="160"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid VerticalAlignment="Center"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderRepeat}" Background="#8EA8FF" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRepeat}" Background="#1FFFFFFF" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid>
          <Ellipse Fill="#26262B" Stroke="#8EA8FF" StrokeThickness="1"/><Ellipse Width="6" Height="6" Fill="White"/>
        </Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      </Track></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
