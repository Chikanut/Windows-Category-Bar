<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CategoryBar.Core/CategoryBar.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="CategoryBar.ThemeTests" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/*.ico" /><Resource Include="Assets/*.png" /></ItemGroup>
</Project>
